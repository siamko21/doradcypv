---
---

<section id="oferta" class="py-16 sm:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="font-heading font-extrabold text-3xl sm:text-4xl mb-4">Nasza oferta</h2>
      <p class="font-body text-slate-600 text-lg max-w-2xl mx-auto">Fotowoltaika z magazynem energii — kompleksowo, od projektu do montażu</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
      <!-- Card 1: Fotowoltaika + Magazyn -->
      <div class="relative bg-gradient-to-br from-brand-light to-white rounded-3xl p-8 border border-stone-200 hover:shadow-xl transition-shadow">
        <div class="inline-flex items-center gap-2 bg-brand-primary text-white font-heading text-xs font-bold px-3 py-1 rounded-full mb-6">
          Najpopularniejsze
        </div>
        <h3 class="font-heading font-bold text-2xl mb-3">Fotowoltaika + Magazyn energii</h3>
        <p class="font-body text-slate-600 text-sm mb-6">Produkuj własny prąd i magazynuj nadwyżki. Niezależność od rosnących cen energii.</p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-slate-700">Panele fotowoltaiczne najnowszej generacji</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-slate-700">Magazyn energii — prąd także w nocy</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-slate-700">Redukcja rachunków nawet o 90%</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-primary flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-slate-700">Gwarancja wydajności do 25 lat</span>
          </li>
        </ul>
        <a href="#kontakt" class="inline-flex items-center justify-center w-full px-6 py-3.5 bg-brand-primary hover:bg-brand-primary-dark text-white font-heading font-semibold text-sm rounded-xl transition-all">
          Poproś o wycenę
        </a>
      </div>

      <!-- Card 2: Dofinansowania -->
      <div class="bg-gradient-to-br from-stone-50 to-white rounded-3xl p-8 border border-stone-200 hover:shadow-xl transition-shadow">
        <div class="inline-flex items-center gap-2 bg-brand-accent text-white font-heading text-xs font-bold px-3 py-1 rounded-full mb-6">
          Oszczędź więcej
        </div>
        <h3 class="font-heading font-bold text-2xl mb-3">Dofinansowania</h3>
        <p class="font-body text-slate-600 text-sm mb-6">Pomożemy Ci uzyskać dofinansowanie — zajmiemy się formalnościami.</p>
        <ul class="space-y-3 mb-8">
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-slate-700"><strong>PME2</strong> — do 19 000 zł dotacji na magazyn energii, <a href="/dotacje/przydomowe-magazyny-energii-2026" class="text-brand-accent underline hover:no-underline">szczegóły i termin naboru</a></span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-slate-700"><strong>Czyste Powietrze</strong> — dotacja + preferencyjny kredyt</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-slate-700"><strong>Ulga termomodernizacyjna</strong> — odlicz od podatku</span>
          </li>
          <li class="flex items-start gap-3">
            <svg class="w-5 h-5 text-brand-accent flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
            </svg>
            <span class="font-body text-sm text-slate-700">Pomoc w kompletowaniu dokumentów</span>
          </li>
        </ul>
        <a href="#kontakt" class="inline-flex items-center justify-center w-full px-6 py-3.5 border-2 border-brand-accent text-brand-accent-dark hover:bg-stone-50 font-heading font-semibold text-sm rounded-xl transition-all">
          Sprawdź dofinansowanie
        </a>
      </div>
    </div>
  </div>
</section>
