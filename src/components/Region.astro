---
const regions = [
  { name: "Wielkopolska", cities: "Poznań, Kalisz, Konin, Piła, Leszno" },
  { name: "Kujawy", cities: "Bydgoszcz, Toruń, Inowrocław, Włocławek" },
  { name: "Pomorze", cities: "Gdańsk, Gdynia, Sopot, Słupsk, Starogard" }
];
---

<section id="region" class="py-16 sm:py-24 bg-gradient-brand text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="font-heading font-extrabold text-3xl sm:text-4xl mb-4">Działamy lokalnie</h2>
      <p class="font-body text-white/70 text-lg max-w-2xl mx-auto">Znamy Twój region. Obsługujemy trzy województwa — jesteśmy blisko Ciebie.</p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {regions.map((r) => (
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-6 sm:p-8 border border-white/20">
          <div class="flex items-center gap-3 mb-4">
            <svg class="w-6 h-6 text-brand-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
            </svg>
            <h3 class="font-heading font-bold text-xl">{r.name}</h3>
          </div>
          <p class="font-body text-white/70 text-sm">{r.cities}</p>
        </div>
      ))}
    </div>

    <div class="text-center mt-12">
      <a href="#kontakt" class="inline-flex items-center px-8 py-4 bg-white text-brand-secondary font-heading font-bold text-base rounded-xl hover:bg-brand-light transition-all duration-200 shadow-lg">
        Zamów wycenę dla Twojej lokalizacji
      </a>
    </div>
  </div>
</section>
