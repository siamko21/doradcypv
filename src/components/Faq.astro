---
const faqs = [
  {
    q: "Ile kosztuje instalacja fotowoltaiczna?",
    a: "Cena zależy od mocy instalacji i typu dachu. Typowy zestaw fotowoltaika + magazyn energii dla domu jednorodzinnego to koszt od ok. 25 000 PLN. Dzięki dofinansowaniom (Mój Prąd, Czyste Powietrze) możesz odzyskać nawet połowę kosztów. Zamów bezpłatną wycenę — przeliczymy dla Ciebie."
  },
  {
    q: "Jak długo trwa montaż?",
    a: "Sam montaż trwa zazwyczaj 1-2 dni robocze. Cały proces — od wyceny, przez projekt, do uruchomienia instalacji — zajmuje kilka tygodni, w zależności od dostępności komponentów i formalności."
  },
  {
    q: "Jakie dofinansowania mogę otrzymać?",
    a: "Aktualnie dostępne programy to Mój Prąd (do 28 000 PLN na instalację z magazynem energii), Czyste Powietrze (dotacja + preferencyjny kredyt) oraz ulga termomodernizacyjna (odliczenie od podatku do 53 000 PLN). Pomagamy złożyć wnioski — wszystko załatwimy za Ciebie."
  },
  {
    q: "Czy panele działają zimą i w pochmurne dni?",
    a: "Tak! Panele fotowoltaiczne działają na podstawie światła, nie ciepła. Zimą produkcja jest mniejsza, ale magazyn energii pozwala gromadzić nadwyżki z lata. Nowoczesne panele pracują nawet przy zachmurzeniu."
  },
  {
    q: "Na jaki region dojeżdżacie?",
    a: "Obsługujemy Wielkopolskę, Kujawy i Pomorze. Niezależnie czy mieszkasz w Poznaniu, Bydgoszczy czy Gdańsku — dojedziemy i bezpłatnie wycenimy instalację."
  }
];
---

<section id="faq" class="py-16 sm:py-24 bg-white">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="font-heading font-extrabold text-3xl sm:text-4xl mb-4">Często zadawane pytania</h2>
    </div>

    <div class="space-y-4">
      {faqs.map((faq, i) => (
        <details class="group bg-brand-light rounded-2xl border border-stone-200 overflow-hidden">
          <summary class="flex items-center justify-between cursor-pointer p-5 sm:p-6 font-heading font-semibold text-base sm:text-lg text-brand-dark hover:text-brand-primary transition-colors list-none">
            <span>{faq.q}</span>
            <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </summary>
          <div class="px-5 sm:px-6 pb-5 sm:pb-6">
            <p class="font-body text-slate-600 text-sm leading-relaxed">{faq.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
