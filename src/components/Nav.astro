---
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-stone-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2">
        <img src="/logo.png" alt="DoradcyPV" class="h-16 w-auto" />
        <span class="font-heading font-extrabold text-3xl text-brand-dark">Doradcy<span class="text-brand-primary">PV</span></span>
      </a>

      <!-- Desktop links -->
      <div class="hidden md:flex items-center gap-8">
        <a href="#oferta" class="font-body text-sm text-slate-600 hover:text-brand-primary transition-colors">Oferta</a>
        <a href="#jak-to-dziala" class="font-body text-sm text-slate-600 hover:text-brand-primary transition-colors">Jak to działa</a>
        <a href="#region" class="font-body text-sm text-slate-600 hover:text-brand-primary transition-colors">Region</a>
        <a href="#faq" class="font-body text-sm text-slate-600 hover:text-brand-primary transition-colors">FAQ</a>
        <a href="#kontakt" class="inline-flex items-center px-5 py-2.5 bg-brand-primary hover:bg-brand-primary-dark text-white font-heading font-semibold text-sm rounded-xl transition-all duration-200">
          Darmowa wycena
        </a>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden p-2 text-slate-600 hover:text-brand-primary" aria-label="Menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div id="mobile-menu" class="hidden md:hidden pb-4">
      <div class="flex flex-col gap-3">
        <a href="#oferta" class="font-body text-sm text-slate-600 hover:text-brand-primary py-2">Oferta</a>
        <a href="#jak-to-dziala" class="font-body text-sm text-slate-600 hover:text-brand-primary py-2">Jak to działa</a>
        <a href="#region" class="font-body text-sm text-slate-600 hover:text-brand-primary py-2">Region</a>
        <a href="#faq" class="font-body text-sm text-slate-600 hover:text-brand-primary py-2">FAQ</a>
        <a href="#kontakt" class="inline-flex items-center justify-center px-5 py-2.5 bg-brand-primary text-white font-heading font-semibold text-sm rounded-xl">
          Darmowa wycena
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => menu?.classList.add('hidden')));
</script>
