<footer class="bg-brand-dark text-white">
  <!-- CTA band -->
  <div class="bg-gradient-to-r from-brand-accent to-brand-accent-dark">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 text-center">
      <h2 class="font-heading font-extrabold text-2xl sm:text-3xl mb-3">Gotowy na własną energię?</h2>
      <p class="font-body text-white/60 text-base mb-8 max-w-xl mx-auto">Zamów bezpłatną wycenę. Oddzwonimy w ciągu godziny.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#kontakt" class="inline-flex items-center justify-center px-8 py-4 bg-white text-brand-accent font-heading font-bold text-base rounded-xl hover:bg-stone-50 transition-all shadow-lg">
          Zamów bezpłatną wycenę
        </a>
        <a href="tel:+48000000000" class="inline-flex items-center justify-center px-8 py-4 border-2 border-white/40 text-white hover:bg-white/10 font-heading font-semibold text-base rounded-xl transition-all">
          <svg class="w-5 h-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Zadzwoń teraz
        </a>
      </div>
    </div>
  </div>

  <!-- Footer bottom -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <img src="/logo.png" alt="DoradcyPV" class="h-7 w-auto" />
        <span class="font-heading font-bold text-sm">DoradcyPV</span>
      </div>
      <p class="font-body text-sm text-slate-400">
        Wielkopolska, Kujawy, Pomorze
      </p>
      <p class="font-body text-xs text-slate-500">
        &copy; 2026 DoradcyPV. Wszelkie prawa zastrzeżone.
      </p>
    </div>
  </div>
</footer>
