---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Polityka Prywatności — DoradcyPV"
  description="Polityka prywatności i ochrony danych osobowych DoradcyPV. Dowiedz się, jak przetwarzamy Twoje dane."
>
  <Nav />

  <main class="min-h-screen bg-gray-50 pt-24 pb-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="mb-10">
        <a href="/" class="inline-flex items-center gap-2 text-brand-primary font-body text-sm font-medium hover:text-brand-secondary transition-colors mb-6">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Wróć na stronę główną
        </a>
        <h1 class="font-heading font-extrabold text-3xl sm:text-4xl text-brand-dark mb-3">
          Polityka prywatności
        </h1>
        <p class="font-body text-slate-500 text-sm">
          Ostatnia aktualizacja: marzec 2026
        </p>
      </div>

      <!-- Content card -->
      <div class="bg-white rounded-2xl border border-stone-200 shadow-sm divide-y divide-stone-100">

        <!-- 1. Administrator -->
        <div class="p-6 sm:p-8">
          <h2 class="font-heading font-bold text-lg text-brand-dark mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 bg-brand-light text-brand-primary rounded-full text-sm font-bold">1</span>
            Administrator danych osobowych
          </h2>
          <p class="font-body text-slate-600 text-sm leading-relaxed">
            Administratorem Twoich danych osobowych jest <strong class="text-brand-dark">DoradcyPV</strong> — niezależna firma doradcza specjalizująca się w instalacjach fotowoltaicznych i magazynach energii, działająca na terenie Wielkopolski, Kujaw i Pomorza.
          </p>
          <p class="font-body text-slate-600 text-sm leading-relaxed mt-3">
            Kontakt z administratorem: <a href="mailto:kontakt@doradcypv.pl" class="text-brand-primary hover:underline">kontakt@doradcypv.pl</a>
          </p>
        </div>

        <!-- 2. Jakie dane zbieramy -->
        <div class="p-6 sm:p-8">
          <h2 class="font-heading font-bold text-lg text-brand-dark mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 bg-brand-light text-brand-primary rounded-full text-sm font-bold">2</span>
            Jakie dane zbieramy
          </h2>
          <p class="font-body text-slate-600 text-sm leading-relaxed mb-3">
            Za pośrednictwem formularza kontaktowego na stronie zbieramy następujące dane:
          </p>
          <ul class="space-y-2">
            <li class="flex items-start gap-2 font-body text-sm text-slate-600">
              <svg class="w-4 h-4 text-brand-primary mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
              </svg>
              <span><strong class="text-brand-dark">Imię</strong> — w celu personalnego kontaktu</span>
            </li>
            <li class="flex items-start gap-2 font-body text-sm text-slate-600">
              <svg class="w-4 h-4 text-brand-primary mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
              </svg>
              <span><strong class="text-brand-dark">Numer telefonu</strong> — w celu oddzwonienia z wyceną</span>
            </li>
            <li class="flex items-start gap-2 font-body text-sm text-slate-600">
              <svg class="w-4 h-4 text-brand-primary mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
              </svg>
              <span><strong class="text-brand-dark">Kod pocztowy</strong> — w celu określenia obszaru obsługi i przygotowania wyceny</span>
            </li>
            <li class="flex items-start gap-2 font-body text-sm text-slate-600">
              <svg class="w-4 h-4 text-brand-primary mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.857-9.809a.75.75 0 00-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 10-1.06 1.061l2.5 2.5a.75.75 0 001.137-.089l4-5.5z" clip-rule="evenodd" />
              </svg>
              <span><strong class="text-brand-dark">Typ dachu</strong> — dane techniczne niezbędne do przygotowania oferty</span>
            </li>
          </ul>
          <p class="font-body text-slate-600 text-sm leading-relaxed mt-3">
            Podanie danych jest dobrowolne, jednak niezbędne do przygotowania bezpłatnej wyceny instalacji.
          </p>
        </div>

        <!-- 3. Cel i podstawa przetwarzania -->
        <div class="p-6 sm:p-8">
          <h2 class="font-heading font-bold text-lg text-brand-dark mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 bg-brand-light text-brand-primary rounded-full text-sm font-bold">3</span>
            Cel i podstawa prawna przetwarzania
          </h2>
          <p class="font-body text-slate-600 text-sm leading-relaxed mb-3">
            Twoje dane przetwarzamy w następujących celach:
          </p>
          <div class="space-y-3">
            <div class="bg-brand-light/50 rounded-xl p-4">
              <p class="font-body text-sm text-brand-dark font-medium mb-1">Przygotowanie bezpłatnej wyceny instalacji fotowoltaicznej</p>
              <p class="font-body text-xs text-slate-500">Podstawa: Twoja zgoda (art. 6 ust. 1 lit. a RODO)</p>
            </div>
            <div class="bg-brand-light/50 rounded-xl p-4">
              <p class="font-body text-sm text-brand-dark font-medium mb-1">Kontakt telefoniczny lub elektroniczny w sprawie oferty</p>
              <p class="font-body text-xs text-slate-500">Podstawa: Twoja zgoda (art. 6 ust. 1 lit. a RODO)</p>
            </div>
            <div class="bg-brand-light/50 rounded-xl p-4">
              <p class="font-body text-sm text-brand-dark font-medium mb-1">Marketing usług własnych — informacje o promocjach i aktualnych ofertach</p>
              <p class="font-body text-xs text-slate-500">Podstawa: prawnie uzasadniony interes administratora (art. 6 ust. 1 lit. f RODO)</p>
            </div>
          </div>
        </div>

        <!-- 4. Retencja danych -->
        <div class="p-6 sm:p-8">
          <h2 class="font-heading font-bold text-lg text-brand-dark mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 bg-brand-light text-brand-primary rounded-full text-sm font-bold">4</span>
            Jak długo przechowujemy Twoje dane
          </h2>
          <p class="font-body text-slate-600 text-sm leading-relaxed">
            Dane osobowe przechowujemy przez okres niezbędny do realizacji celu, w jakim zostały zebrane:
          </p>
          <ul class="mt-3 space-y-2">
            <li class="font-body text-sm text-slate-600 flex items-start gap-2">
              <span class="text-brand-primary font-bold shrink-0">—</span>
              Jeśli nie dojdzie do zawarcia umowy — przez <strong class="text-brand-dark">12 miesięcy</strong> od ostatniego kontaktu.
            </li>
            <li class="font-body text-sm text-slate-600 flex items-start gap-2">
              <span class="text-brand-primary font-bold shrink-0">—</span>
              Jeśli zostanie zawarta umowa — przez czas jej realizacji, a następnie przez <strong class="text-brand-dark">5 lat</strong> ze względu na wymogi rachunkowe i prawne.
            </li>
          </ul>
          <p class="font-body text-slate-600 text-sm leading-relaxed mt-3">
            Dane możesz usunąć wcześniej, korzystając z praw opisanych poniżej.
          </p>
        </div>

        <!-- 5. Twoje prawa -->
        <div class="p-6 sm:p-8">
          <h2 class="font-heading font-bold text-lg text-brand-dark mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 bg-brand-light text-brand-primary rounded-full text-sm font-bold">5</span>
            Twoje prawa
          </h2>
          <p class="font-body text-slate-600 text-sm leading-relaxed mb-4">
            Na podstawie RODO przysługują Ci następujące prawa:
          </p>
          <div class="grid sm:grid-cols-2 gap-3">
            <div class="border border-stone-200 rounded-xl p-4">
              <p class="font-heading font-semibold text-sm text-brand-dark mb-1">Prawo dostępu</p>
              <p class="font-body text-xs text-slate-500">Możesz zażądać kopii swoich danych, które przetwarzamy.</p>
            </div>
            <div class="border border-stone-200 rounded-xl p-4">
              <p class="font-heading font-semibold text-sm text-brand-dark mb-1">Prawo do sprostowania</p>
              <p class="font-body text-xs text-slate-500">Możesz poprawić nieprawidłowe lub niekompletne dane.</p>
            </div>
            <div class="border border-stone-200 rounded-xl p-4">
              <p class="font-heading font-semibold text-sm text-brand-dark mb-1">Prawo do usunięcia</p>
              <p class="font-body text-xs text-slate-500">Możesz zażądać usunięcia swoich danych ("prawo do bycia zapomnianym").</p>
            </div>
            <div class="border border-stone-200 rounded-xl p-4">
              <p class="font-heading font-semibold text-sm text-brand-dark mb-1">Prawo do sprzeciwu</p>
              <p class="font-body text-xs text-slate-500">Możesz sprzeciwić się przetwarzaniu danych w celach marketingowych.</p>
            </div>
            <div class="border border-stone-200 rounded-xl p-4">
              <p class="font-heading font-semibold text-sm text-brand-dark mb-1">Prawo do przenoszenia</p>
              <p class="font-body text-xs text-slate-500">Możesz otrzymać swoje dane w formacie nadającym się do odczytu maszynowego.</p>
            </div>
            <div class="border border-stone-200 rounded-xl p-4">
              <p class="font-heading font-semibold text-sm text-brand-dark mb-1">Prawo do cofnięcia zgody</p>
              <p class="font-body text-xs text-slate-500">Możesz w każdej chwili cofnąć zgodę bez wpływu na zgodność z prawem wcześniejszego przetwarzania.</p>
            </div>
          </div>
          <p class="font-body text-slate-600 text-sm leading-relaxed mt-4">
            Aby skorzystać z powyższych praw, skontaktuj się z nami pod adresem: <a href="mailto:kontakt@doradcypv.pl" class="text-brand-primary hover:underline">kontakt@doradcypv.pl</a>
          </p>
          <p class="font-body text-slate-600 text-sm leading-relaxed mt-2">
            Masz także prawo wniesienia skargi do <strong class="text-brand-dark">Prezesa Urzędu Ochrony Danych Osobowych</strong> (PUODO), ul. Stawki 2, 00-193 Warszawa, jeśli uważasz, że przetwarzanie Twoich danych narusza przepisy RODO.
          </p>
        </div>

        <!-- 6. Podmioty przetwarzające -->
        <div class="p-6 sm:p-8">
          <h2 class="font-heading font-bold text-lg text-brand-dark mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 bg-brand-light text-brand-primary rounded-full text-sm font-bold">6</span>
            Podmioty przetwarzające dane (procesorzy)
          </h2>
          <p class="font-body text-slate-600 text-sm leading-relaxed mb-3">
            Korzystamy z usług zaufanych podmiotów trzecich, którym powierzamy przetwarzanie danych wyłącznie w zakresie niezbędnym do świadczenia usług:
          </p>
          <div class="space-y-3">
            <div class="flex items-start gap-3 p-4 border border-stone-200 rounded-xl">
              <div class="w-8 h-8 bg-brand-light rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                </svg>
              </div>
              <div>
                <p class="font-heading font-semibold text-sm text-brand-dark">Formspree (formspree.io)</p>
                <p class="font-body text-xs text-slate-500 mt-0.5">Obsługa formularza kontaktowego. Dane są przekazywane do Formspree w celu dostarczenia zgłoszenia. Formspree nie wykorzystuje danych w żadnym innym celu. Serwery mogą znajdować się poza EOG — Formspree zapewnia odpowiednie gwarancje ochrony danych (standardowe klauzule umowne).</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 border border-stone-200 rounded-xl">
              <div class="w-8 h-8 bg-brand-light rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />
                </svg>
              </div>
              <div>
                <p class="font-heading font-semibold text-sm text-brand-dark">Cloudflare (cloudflare.com)</p>
                <p class="font-body text-xs text-slate-500 mt-0.5">Hosting strony internetowej i sieć CDN. Cloudflare przetwarza dane techniczne (adres IP, nagłówki HTTP) w celu dostarczenia strony i ochrony przed atakami. Cloudflare jest certyfikowany zgodnie z przepisami o ochronie danych.</p>
              </div>
            </div>
            <div class="flex items-start gap-3 p-4 border border-stone-200 rounded-xl">
              <div class="w-8 h-8 bg-brand-light rounded-lg flex items-center justify-center shrink-0">
                <svg class="w-4 h-4 text-brand-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.864 4.243A7.5 7.5 0 0119.5 10.5c0 2.92-.556 5.709-1.568 8.268M5.742 6.364A7.465 7.465 0 004.5 10.5a7.464 7.464 0 01-1.15 3.993m1.989 3.559A11.209 11.209 0 008.25 10.5a3.75 3.75 0 117.5 0c0 .527-.021 1.049-.064 1.565M12 10.5a14.94 14.94 0 01-3.6 9.75m6.633-4.596a18.666 18.666 0 01-2.485 5.33" />
                </svg>
              </div>
              <div>
                <p class="font-heading font-semibold text-sm text-brand-dark">Meta Platforms (Facebook / Instagram Ads)</p>
                <p class="font-body text-xs text-slate-500 mt-0.5">W ramach kampanii reklamowych możemy korzystać z Meta Pixel — narzędzia analitycznego Meta, które zbiera dane o wizytach na stronie w celu mierzenia skuteczności reklam i tworzenia grup docelowych. Dane przekazywane do Meta podlegają polityce prywatności Meta. Możesz zarządzać swoimi ustawieniami prywatności na Facebooku lub zrezygnować z reklam spersonalizowanych pod adresem: <a href="https://www.facebook.com/ads/preferences" target="_blank" rel="noopener noreferrer" class="text-brand-primary hover:underline">facebook.com/ads/preferences</a>.</p>
              </div>
            </div>
          </div>
          <p class="font-body text-slate-600 text-sm leading-relaxed mt-3">
            Nie sprzedajemy Twoich danych osobowych żadnym podmiotom trzecim.
          </p>
        </div>

        <!-- 7. Pliki cookies -->
        <div class="p-6 sm:p-8">
          <h2 class="font-heading font-bold text-lg text-brand-dark mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 bg-brand-light text-brand-primary rounded-full text-sm font-bold">7</span>
            Pliki cookies
          </h2>
          <p class="font-body text-slate-600 text-sm leading-relaxed mb-3">
            Nasza strona może używać plików cookies (ciasteczek) — małych plików tekstowych zapisywanych na Twoim urządzeniu. Używamy cookies w następujących celach:
          </p>
          <ul class="space-y-2">
            <li class="font-body text-sm text-slate-600 flex items-start gap-2">
              <span class="text-brand-primary font-bold shrink-0">—</span>
              <span><strong class="text-brand-dark">Techniczne</strong> — niezbędne do prawidłowego działania strony (np. sesja formularza).</span>
            </li>
            <li class="font-body text-sm text-slate-600 flex items-start gap-2">
              <span class="text-brand-primary font-bold shrink-0">—</span>
              <span><strong class="text-brand-dark">Analityczne</strong> — statystyki odwiedzin (anonimowe dane agregowane).</span>
            </li>
            <li class="font-body text-sm text-slate-600 flex items-start gap-2">
              <span class="text-brand-primary font-bold shrink-0">—</span>
              <span><strong class="text-brand-dark">Marketingowe</strong> — Meta Pixel (jeśli aktywny) do mierzenia skuteczności reklam na Facebooku i Instagramie.</span>
            </li>
          </ul>
          <p class="font-body text-slate-600 text-sm leading-relaxed mt-3">
            Możesz zarządzać plikami cookies w ustawieniach swojej przeglądarki. Wyłączenie cookies technicznych może wpłynąć na działanie strony.
          </p>
        </div>

        <!-- 8. Kontakt -->
        <div class="p-6 sm:p-8">
          <h2 class="font-heading font-bold text-lg text-brand-dark mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 bg-brand-light text-brand-primary rounded-full text-sm font-bold">8</span>
            Kontakt w sprawach danych osobowych
          </h2>
          <p class="font-body text-slate-600 text-sm leading-relaxed">
            W sprawach dotyczących ochrony danych osobowych możesz skontaktować się z nami:
          </p>
          <div class="mt-3 p-4 bg-brand-light/50 rounded-xl">
            <p class="font-body text-sm text-brand-dark font-medium">DoradcyPV</p>
            <p class="font-body text-sm text-slate-600 mt-1">
              E-mail: <a href="mailto:kontakt@doradcypv.pl" class="text-brand-primary hover:underline">kontakt@doradcypv.pl</a>
            </p>
            <p class="font-body text-sm text-slate-600">
              Strona: <a href="https://doradcypv.pl" class="text-brand-primary hover:underline">doradcypv.pl</a>
            </p>
          </div>
        </div>

        <!-- 9. Zmiany polityki -->
        <div class="p-6 sm:p-8">
          <h2 class="font-heading font-bold text-lg text-brand-dark mb-3 flex items-center gap-2">
            <span class="inline-flex items-center justify-center w-7 h-7 bg-brand-light text-brand-primary rounded-full text-sm font-bold">9</span>
            Zmiany polityki prywatności
          </h2>
          <p class="font-body text-slate-600 text-sm leading-relaxed">
            Zastrzegamy sobie prawo do aktualizacji niniejszej polityki prywatności. Wszelkie zmiany będą publikowane na tej stronie wraz z datą ostatniej aktualizacji. Zachęcamy do regularnego sprawdzania polityki.
          </p>
        </div>

      </div>

      <!-- Bottom note -->
      <p class="font-body text-xs text-slate-400 text-center mt-8">
        DoradcyPV &copy; 2026 &middot; Polityka prywatności zgodna z RODO (Rozporządzenie EU 2016/679)
      </p>

    </div>
  </main>

  <Footer />
</BaseLayout>
